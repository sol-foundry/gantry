'use strict';

// Zero-dependency WebSocket gateway (pub/sub relay); runs on a stock node image, so `up` needs no npm install.
//   GET  /ws           WebSocket; client sends {action: "subscribe"|"unsubscribe", topic | topics}
//   POST /publish      {topic, eventType | event_type, payload} -> every subscriber of topic
//   POST /subscribe    {topic | topics} -> registered for EVERY open connection (no connection ids locally)
//   POST /unsubscribe  {topic | topics}
//   GET  /health       {status, topics, connections}

const http = require('node:http');
const crypto = require('node:crypto');

const PORT = 8080;
const WS_GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11';
const MAX_MESSAGE_BYTES = 1 << 20;
const MAX_BODY_BYTES = 1 << 20;
// A subscriber this far behind is dropped rather than buffered without bound.
const MAX_BUFFERED_BYTES = 8 << 20;
// Under the gateway's 60 s proxy read timeout, so idle sockets stay open and dead peers are found.
const PING_INTERVAL_MS = 25_000;

const subscriptions = new Map(); // topic -> Set<conn>
const connections = new Map();   // conn -> Set<topic>
let connectionCounter = 0;

function log(tag, message, data) {
  const detail = data !== undefined ? ` ${JSON.stringify(data)}` : '';
  console.log(`${new Date().toISOString()} [${tag}] ${message}${detail}`);
}

process.on('uncaughtException', (err) => log('ERROR', 'uncaught exception', { error: String(err?.stack ?? err) }));
process.on('unhandledRejection', (err) => log('ERROR', 'unhandled rejection', { error: String(err?.stack ?? err) }));

function frame(opcode, payload) {
  const len = payload.length;
  let header;
  if (len < 126) {
    header = Buffer.from([0x80 | opcode, len]);
  } else if (len < 65536) {
    header = Buffer.alloc(4);
    header[0] = 0x80 | opcode;
    header[1] = 126;
    header.writeUInt16BE(len, 2);
  } else {
    header = Buffer.alloc(10);
    header[0] = 0x80 | opcode;
    header[1] = 127;
    header.writeBigUInt64BE(BigInt(len), 2);
  }
  return Buffer.concat([header, payload]);
}

function send(conn, opcode, payload) {
  if (!conn.open) return;
  if (conn.socket.writableLength > MAX_BUFFERED_BYTES) {
    log('WS', `#${conn.id} too slow, dropping`);
    return close(conn, 1008);
  }
  conn.socket.write(frame(opcode, payload));
}

function sendJson(conn, value) {
  send(conn, 0x1, Buffer.from(JSON.stringify(value)));
}

function subscribe(conn, topic) {
  if (!subscriptions.has(topic)) subscriptions.set(topic, new Set());
  subscriptions.get(topic).add(conn);
  connections.get(conn)?.add(topic);
  log('SUB', `+subscribe topic="${topic}" subscribers=${subscriptions.get(topic).size}`);
}

function unsubscribe(conn, topic) {
  const subscribers = subscriptions.get(topic);
  if (subscribers) {
    subscribers.delete(conn);
    if (subscribers.size === 0) subscriptions.delete(topic);
  }
  connections.get(conn)?.delete(topic);
}

/** Sends a close frame with [code] (none for a dead socket), then forgets the connection. */
function close(conn, code) {
  if (!conn.open) return;
  conn.open = false;
  clearInterval(conn.heartbeat);
  for (const topic of connections.get(conn) ?? []) unsubscribe(conn, topic);
  connections.delete(conn);
  if (code === undefined) {
    conn.socket.destroy();
  } else {
    const body = Buffer.alloc(2);
    body.writeUInt16BE(code);
    conn.socket.end(frame(0x8, body));
  }
  log('WS', `#${conn.id} disconnected (total=${connections.size})`);
}

function topicsOf(message) {
  const topics = Array.isArray(message?.topics) ? message.topics : [message?.topic];
  return topics.filter((t) => typeof t === 'string' && t);
}

function onMessage(conn, text) {
  let message;
  try {
    message = JSON.parse(text);
  } catch {
    message = undefined;
  }
  if (!message || typeof message !== 'object') {
    sendJson(conn, { eventType: 'error', payload: { message: 'invalid json message' } });
    return;
  }
  const topics = topicsOf(message);
  if (message.action === 'subscribe' || message.action === 'unsubscribe') {
    topics.forEach((topic) => (message.action === 'subscribe' ? subscribe : unsubscribe)(conn, topic));
    sendJson(conn, { eventType: 'subscription.updated', payload: { action: message.action, topics } });
    return;
  }
  sendJson(conn, { eventType: 'error', payload: { message: 'unsupported action' } });
}

// RFC 6455 framing: client frames must be masked, control frames are short and unfragmented and may
// arrive between the fragments of a message, which are reassembled before onMessage.
function onData(conn, chunk) {
  conn.buffer = conn.buffer.length ? Buffer.concat([conn.buffer, chunk]) : chunk;
  while (conn.open && conn.buffer.length >= 2) {
    const b = conn.buffer;
    const fin = (b[0] & 0x80) !== 0;
    const opcode = b[0] & 0x0f;
    if ((b[1] & 0x80) === 0) return close(conn, 1002);
    let len = b[1] & 0x7f;
    let offset = 2;
    if (len === 126) {
      if (b.length < 4) return;
      len = b.readUInt16BE(2);
      offset = 4;
    } else if (len === 127) {
      if (b.length < 10) return;
      len = Number(b.readBigUInt64BE(2));
      offset = 10;
    }
    const control = opcode >= 0x8;
    if (control && (!fin || len > 125)) return close(conn, 1002);
    if (len > MAX_MESSAGE_BYTES) return close(conn, 1009);
    if (b.length < offset + 4 + len) return;
    const mask = b.subarray(offset, offset + 4);
    const payload = Buffer.from(b.subarray(offset + 4, offset + 4 + len));
    for (let i = 0; i < payload.length; i++) payload[i] ^= mask[i % 4];
    conn.buffer = b.subarray(offset + 4 + len);

    if (opcode === 0x8) return close(conn, payload.length >= 2 ? payload.readUInt16BE(0) : 1000);
    if (opcode === 0x9) {
      send(conn, 0xa, payload);
      continue;
    }
    if (opcode === 0xa) {
      conn.alive = true;
      continue;
    }
    if (opcode !== 0x1 && opcode !== 0x0) return close(conn, 1003);
    conn.fragmentBytes += payload.length;
    if (conn.fragmentBytes > MAX_MESSAGE_BYTES) return close(conn, 1009);
    conn.fragments.push(payload);
    if (fin) {
      const text = Buffer.concat(conn.fragments).toString('utf8');
      conn.fragments = [];
      conn.fragmentBytes = 0;
      onMessage(conn, text);
    }
  }
}

function readJson(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let size = 0;
    // An oversized body is drained, not kept, so the client still gets its 400.
    req.on('data', (c) => {
      size += c.length;
      if (size <= MAX_BODY_BYTES) chunks.push(c);
    });
    req.on('end', () => {
      if (size > MAX_BODY_BYTES) return reject(new Error('body too large'));
      try {
        const text = Buffer.concat(chunks).toString('utf8');
        const body = text ? JSON.parse(text) : {};
        resolve(body && typeof body === 'object' ? body : {});
      } catch (err) {
        reject(err);
      }
    });
    req.on('error', reject);
  });
}

function reply(res, status, body) {
  res.writeHead(status, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify(body));
}

function pathOf(url) {
  return (url ?? '').split('?')[0];
}

const routes = {
  'GET /health': (_body, res) =>
    reply(res, 200, { status: 'ok', topics: subscriptions.size, connections: connections.size }),

  'POST /publish': (body, res) => {
    // Spring apps serialize snake_case, browsers tend to camelCase: accept both.
    const eventType = body.eventType ?? body.event_type;
    if (typeof body.topic !== 'string' || typeof eventType !== 'string') {
      return reply(res, 400, { error: 'topic and eventType/event_type are required' });
    }
    const subscribers = subscriptions.get(body.topic) ?? new Set();
    const delivered = subscribers.size;
    const event = { topic: body.topic, eventType, payload: body.payload ?? {} };
    [...subscribers].forEach((conn) => sendJson(conn, event));
    log('PUBLISH', `topic="${body.topic}" event="${eventType}" delivered=${delivered}`);
    reply(res, 202, { deliveredTo: delivered });
  },

  'POST /subscribe': (body, res) => {
    const topics = topicsOf(body);
    if (topics.length === 0) return reply(res, 400, { error: 'at least one topic required' });
    for (const conn of connections.keys()) topics.forEach((topic) => subscribe(conn, topic));
    reply(res, 200, { subscribed: topics.length });
  },

  'POST /unsubscribe': (body, res) => {
    const topics = topicsOf(body);
    for (const topic of topics) {
      subscriptions.delete(topic);
      for (const topicSet of connections.values()) topicSet.delete(topic);
    }
    reply(res, 200, { unsubscribed: topics.length });
  },
};

const server = http.createServer(async (req, res) => {
  try {
    const handler = routes[`${req.method} ${pathOf(req.url)}`];
    if (!handler) return reply(res, 404, { error: 'not found' });
    let body = {};
    if (req.method === 'POST') {
      try {
        body = await readJson(req);
      } catch {
        return reply(res, 400, { error: 'invalid or oversized json body' });
      }
    }
    handler(body, res);
  } catch (err) {
    log('ERROR', 'request failed', { error: String(err) });
    if (!res.headersSent) reply(res, 500, { error: 'internal error' });
  }
});

server.on('upgrade', (req, socket) => {
  const key = req.headers['sec-websocket-key'];
  if (pathOf(req.url) !== '/ws' || !key) {
    socket.end('HTTP/1.1 400 Bad Request\r\n\r\n');
    return;
  }
  const accept = crypto.createHash('sha1').update(key + WS_GUID).digest('base64');
  socket.write(
    'HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n' +
      `Sec-WebSocket-Accept: ${accept}\r\n\r\n`,
  );
  socket.setNoDelay(true);

  const conn = {
    id: ++connectionCounter,
    socket,
    open: true,
    alive: true,
    buffer: Buffer.alloc(0),
    fragments: [],
    fragmentBytes: 0,
  };
  conn.heartbeat = setInterval(() => {
    if (!conn.alive) return close(conn);
    conn.alive = false;
    send(conn, 0x9, Buffer.alloc(0));
  }, PING_INTERVAL_MS);
  connections.set(conn, new Set());
  log('WS', `#${conn.id} connected (total=${connections.size})`);
  sendJson(conn, { eventType: 'connection.ready', payload: { connected: true } });

  socket.on('data', (chunk) => {
    try {
      onData(conn, chunk);
    } catch (err) {
      log('ERROR', `#${conn.id} frame handling failed`, { error: String(err) });
      close(conn, 1011);
    }
  });
  socket.on('close', () => close(conn));
  socket.on('error', () => close(conn));
});

server.listen(PORT, () => log('STARTUP', `websocket gateway listening on :${PORT}`));
